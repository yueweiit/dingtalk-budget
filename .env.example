# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=budget_system
PGUSER=postgres
PGPASSWORD=your_password_here
PGPOOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=2000

# DingTalk
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_PROCESS_CODE=PROC-XXXX
DINGTALK_OAPI_URL=https://oapi.dingtalk.com
DINGTALK_API_URL=https://api.dingtalk.com
DINGTALK_LIST_API=old
DINGTALK_REQUEST_DELAY_MS=300
DINGTALK_TIMEOUT_MS=15000

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
API_KEY=your_api_key_here
NODE_ENV=production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Resilience (Retry & Circuit Breaker)
RETRY_COUNT=3
RETRY_DELAY_MS=1000
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=60000

# Yunying API
YUNYING_API_BASE=http://localhost:3002
YUNYING_TIMEOUT_MS=15000

# Sync Scheduler
SYNC_CRON=2 * * * *
SYNC_TIMEZONE=Asia/Shanghai
SYNC_INITIAL_LOOKBACK_MINUTES=60
SYNC_BACKFILL_ENABLED=1
SYNC_BACKFILL_INTERVAL_MINUTES=360
SYNC_BACKFILL_LOOKBACK_DAYS=3
